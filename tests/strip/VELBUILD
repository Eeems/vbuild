maintainer="Nathaniel van Diepen <eeems@eeems.email>"
pkgname=test-strip
pkgver=1.0
pkgrel=0
pkgdesc="Test strip support"
url="https://github.com/Eeems/vbuild"
upstream_author="Eeems"
category="utilities"
arch="x86_64"
license="MIT"
options="
strip
"

source="
hello.c
hello-copy.c
"

build() {
	cc -O2 -o "$srcdir/hello" "$srcdir/hello.c"
	cc -O2 -o "$srcdir/hello-copy" "$srcdir/hello-copy.c"
}

package() {
	install -Dm755 "$srcdir/hello" "$pkgdir/usr/bin/hello"
	install -Dm644 "$srcdir/hello-copy.c" "$pkgdir/usr/share/test-strip/hello-copy.c"
}

subpackages="
	test-strip-sub:test_strip_sub
"

test_strip_sub() {
	pkgdesc="Subpackage with its own ELF"
	package() {
		install -Dm755 "$srcdir/hello-copy" "$subpkgdir/usr/bin/hello-copy"
	}
}
